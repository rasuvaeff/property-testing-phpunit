{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    // 164 of 168 mutants are killed (2026-09-18); the remaining four are
    // equivalent, so 100 is unreachable without ignores — which are forbidden
    // here: array_values() on a variadic that is already a list
    // (PropertyCheck::listeners), the (string) cast of a forAll() key PHP
    // canonicalises anyway ("0" and 0 are one array slot and one "%s"), the
    // `checks <= 0` guard where checks is never negative, and the
    // debug_backtrace() limit one frame deeper than the one read.
    "minMsi": 95,
    "mutators": {
        "@default": true
    }
}
