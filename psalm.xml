<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!--
            PHPUnit marks nearly its whole surface @internal by policy, including
            AssertionFailedError — the documented type a third-party integration
            throws to report a FAILURE (an arbitrary exception would surface as an
            ERROR instead) — and TestCase::addToAssertionCount(), the only way a
            passing property registers as an assertion rather than a risky test.
            Constructing AssertionFailedError needs its own entry, and the class
            name in it matters: the constructor is inherited from
            PHPUnit\Framework\Exception, and Psalm's own diagnostic text names
            THAT class ("Constructor PHPUnit\Framework\Exception::__construct is
            internal ..."). Suppressing Exception::__construct verbatim does NOT
            silence it — Psalm keys InternalMethod suppression to the class named
            at the `new` call site (AssertionFailedError), not to the class that
            declares the constructor. Verified empirically; do not "simplify" this
            entry back to Exception::__construct.
            These two classes/methods are this adapter's entire boundary with
            PHPUnit internals; anything else stays at level 1.
        -->
        <InternalClass>
            <errorLevel type="suppress">
                <referencedClass name="PHPUnit\Framework\AssertionFailedError"/>
            </errorLevel>
        </InternalClass>
        <InternalMethod>
            <errorLevel type="suppress">
                <referencedMethod name="PHPUnit\Framework\TestCase::addToAssertionCount"/>
                <referencedMethod name="PHPUnit\Framework\AssertionFailedError::__construct"/>
            </errorLevel>
        </InternalMethod>
    </issueHandlers>
    <!-- CorpusFromEnv types against \Redis; the bundled stub lets psalm analyze
         it without ext-redis being installed. -->
    <enableExtensions>
        <extension name="redis"/>
    </enableExtensions>
</psalm>
